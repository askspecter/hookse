# Rigs paired-coin keeper. Contract addresses, machines and collections come from ../config.js
# (paired block); set LAUNCHER / EXTERNAL_LAUNCHER / START_BLOCK here only to override them.

RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# Dedicated hot wallet for the keeper (EVM). Its address must equal Registry.keeper().
# It only needs ETH for gas; vault funds reach it only through announced, cancellable withdrawals.
KEEPER_PRIVATE_KEY=0x...

# Solana wallet (base58 secret key) that pays for gacha packs and delivers pulled cards.
# Keep ~0.05 SOL in it for fees; USDC arrives from the vaults through Relay.
KEEPER_SOLANA_KEY=
SOLANA_RPC=

# Collector Crypt partner key (x-api-key). Ask Collector Crypt to enable it.
COLLECTOR_CRYPT_API_KEY=
# Optional: https://dev-gacha.collectorcrypt.com for devnet
COLLECTOR_CRYPT_URL=

# OpenSea key for Robinhood Chain floor buys. Empty = auto free-tier key.
OPENSEA_API_KEY=
SWEEP_DISABLED=0

# Floor ceiling = listing + markup (bps); no floor buy or pack above MAX_CEILING_ETH
CEILING_MARKUP_BPS=300
MAX_CEILING_ETH=0.5
# Harvest a router once this much ETH is pending
MIN_HARVEST_ETH=0.005
# Holders with at most this many tokens get no raffle tickets
MIN_TICKET_TOKENS=0

SNAPSHOT_DIR=../snapshots
INTERVAL_SEC=60
# 1 = simulate every transaction but send nothing
DRY_RUN=0
LOG_CHUNK=50000
